[{"start": 0.0, "end": 2.42, "text": "Custom makes all things easy.", "words": [{"w": "Custom", "s": 0.0, "e": 0.82, "v": true}, {"w": "makes", "s": 0.82, "e": 1.32}, {"w": "all", "s": 1.32, "e": 1.58}, {"w": "things", "s": 1.58, "e": 1.88}, {"w": "easy.", "s": 1.88, "e": 2.42}], "ja": "カスタムを行うとすべてが簡単になります。"}, {"start": 5.16, "end": 9.26, "text": "My wife makes it a habit to walk for a while before breakfast.", "words": [{"w": "My", "s": 5.16, "e": 5.92}, {"w": "wife", "s": 5.92, "e": 6.16, "v": true}, {"w": "makes", "s": 6.16, "e": 6.58}, {"w": "it", "s": 6.58, "e": 6.76}, {"w": "a", "s": 6.76, "e": 6.86}, {"w": "habit", "s": 6.86, "e": 7.16, "v": true}, {"w": "to", "s": 7.16, "e": 7.44}, {"w": "walk", "s": 7.44, "e": 7.66}, {"w": "for", "s": 7.66, "e": 7.96}, {"w": "a", "s": 7.96, "e": 8.12}, {"w": "while", "s": 8.12, "e": 8.38, "v": true}, {"w": "before", "s": 8.38, "e": 8.72}, {"w": "breakfast.", "s": 8.72, "e": 9.26}], "ja": "私の妻は朝食前に少し歩くのを習慣にしています。"}, {"start": 12.3, "end": 14.68, "text": "How do you feel after the win?", "words": [{"w": "How", "s": 12.3, "e": 13.06}, {"w": "do", "s": 13.06, "e": 13.22}, {"w": "you", "s": 13.22, "e": 13.38}, {"w": "feel", "s": 13.38, "e": 13.76, "v": true}, {"w": "after", "s": 13.76, "e": 14.2}, {"w": "the", "s": 14.2, "e": 14.4}, {"w": "win?", "s": 14.4, "e": 14.68, "v": true}], "ja": "勝った後の気分はどうですか？"}, {"start": 17.58, "end": 20.0, "text": "How polite your children are!", "words": [{"w": "How", "s": 17.58, "e": 18.34}, {"w": "polite", "s": 18.34, "e": 18.76, "v": true}, {"w": "your", "s": 18.76, "e": 19.16}, {"w": "children", "s": 19.16, "e": 19.62}, {"w": "are!", "s": 19.62, "e": 20.0}], "ja": "あなたの子供たちはなんて礼儀正しいのでしょう！"}, {"start": 22.86, "end": 26.84, "text": "I think this is a decent plan that everyone can agree on.", "words": [{"w": "I", "s": 22.86, "e": 23.5}, {"w": "think", "s": 23.5, "e": 23.78, "v": true}, {"w": "this", "s": 23.78, "e": 24.08}, {"w": "is", "s": 24.08, "e": 24.24}, {"w": "a", "s": 24.24, "e": 24.38}, {