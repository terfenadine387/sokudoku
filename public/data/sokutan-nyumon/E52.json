.4}, {"w": "public", "s": 26.4, "e": 26.86, "v": true}, {"w": "buildings", "s": 26.86, "e": 27.24}, {"w": "in", "s": 27.24, "e": 27.6}, {"w": "this", "s": 27.6, "e": 27.8}, {"w": "city", "s": 27.8, "e": 28.12, "v": true}, {"w": "are", "s": 28.12, "e": 28.38}, {"w": "near", "s": 28.38, "e": 28.58}, {"w": "the", "s": 28.58, "e": 28.82}, {"w": "station.", "s": 28.82, "e": 29.28}], "ja": "この都市のほとんどの公共建物は駅の近くにあります。"}, {"start": 32.18, "end": 34.32, "text": "The news is not official.", "words": [{"w": "The", "s": 32.18, "e": 32.9}, {"w": "news", "s": 32.9, "e": 33.26}, {"w": "is", "s": 33.26, "e": 33.54}, {"w": "not", "s": 33.54, "e": 33.84}, {"w": "official.", "s": 33.84, "e": 34.32, "v": true}], "ja": "そのニュースは公式のものではありません。"}, {"start": 37.66, "end": 41.06, "text": "My diary is private, so please don't read it.", "words": [{"w": "My", "s": 37.66, "e": 38.02}, {"w": "diary", "s": 38.02, "e": 38.36}, {"w": "is", "s": 38.36, "e": 38.82}, {"w": "private,", "s": 38.82, "e": 39.28, "v": true}, {"w": "so", "s": 39.58, "e": 39.82, "v": true}, {"w": "please", "s": 39.82, "e": 40.16, "v": true}, {"w": "don't", "s": 40.16, "e": 40.64}, {"w": "read", "s": 40.64, "e": 40.84}, {"w": "it.", "s": 40.84, "e": 41.06}], "ja": "私の日記は非公開ですので、読まないでください。"}, {"start": 44.2, "end": 45.98, "text": "The region produces lemons.", "words": [{"w": "The", "s": 44.2, "e": 44.56}, {"w": "region", "s": 44.56, "e": 44.96, "v": true}, {"w": "produces", "s": 44.96, "e": 45.54, "v": true}, {"w": "lemons.", "s": 45.54, "e": 45.98}], "ja": "この地域ではレモンが生産されています。"}, {"start": 49.2, "end": 53.76, "text": "Schools in the same district usually compete with each other at sports.", "words": [{"w": "Schools", "s": 49.2, "e": 49.96}, {"w": "in", "s": 49.96, "e": 50.32}, {"w": "the", "s": 50.32, "e": 50.46}, {"w": "same", "s": 50.46, "e": 50.74}, {"w": "district", "s": 50.74, "e": 51.18, "v": true}, {"w": "usually", "s": 51.18, "e": 51.7, "v": true}, {"w": "compete", "s": 51.7, "e": 52.26}, {"w": "with", "s": 52.26, "e":